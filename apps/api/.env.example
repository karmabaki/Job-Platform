# Neon Postgres connection string. Get this from your Neon project dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app refuses to start if this is missing.
JWT_SECRET=

# Origin of the frontend (apps/web), used for CORS with credentials.
# The app refuses to start if this is missing.
WEB_ORIGIN=http://localhost:3000
